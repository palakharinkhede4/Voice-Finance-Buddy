# Option 1: Free Groq API (Recommended — 100% Free, no credit card required)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Option 2: Free Google Gemini API (100% Free, no credit card required)
# Get free key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here

# Option 3: OpenAI API (Optional)
# OPENAI_API_KEY=sk-your-openai-key-here

# Option 4: 100% Local Ollama (Zero API keys needed)
# ARTHBOT_LLM_BACKEND=ollama
# ARTHBOT_OLLAMA_URL=http://localhost:11434

